{
  "author": "taksim",
  "version": 1,
  "origin": "builtin",
  "createdAt": 1791372600000,
  "uses": 0,
  "learned": [],
  "id": "gcp-compute",
  "name": "Compute Engine VM'leri",
  "summary": "Projedeki VM'ler: zone, makine tipi, IP'ler ve durum; çalışmayanlar sayılır, zone'lara dağılım çubukta.",
  "when": [
    "vm'lere bak",
    "compute engine instance'ları",
    "hangi makineler kapalı",
    "gcloud compute instances list",
    "sunucuların IP'leri ne",
    "show my gcp vms",
    "which instances are stopped",
    "makine tipleri ne",
    "bastion açık mı",
    "list compute instances in prod"
  ],
  "keywords": [
    "gcp",
    "gcloud",
    "compute",
    "vm",
    "instance",
    "gce",
    "sunucu",
    "makine",
    "zone",
    "google cloud"
  ],
  "requires": {
    "bin": [
      "gcloud"
    ]
  },
  "params": {
    "project": {
      "desc": "Google Cloud project id (gcloud projects list)",
      "default": null
    }
  },
  "instructions": "Panel lists the project's VM instances every 30s (gcloud's own table: zone, machine type, preemptible, internal/external IP, status), counts the ones not RUNNING and shows how instances spread over zones. To explain a stopped or failing VM read `gcloud compute instances describe <name> --zone <zone> --project <project>` and its serial output (`gcloud compute instances get-serial-port-output`) before guessing. Always pass the same --project. Don't start, stop, ssh or delete unless the user asks.",
  "spec": {
    "title": "VM · {{project}}",
    "sources": {
      "vms": {
        "brick": "command",
        "run": [
          "gcloud",
          "compute",
          "instances",
          "list",
          "--project",
          "{{project}}"
        ],
        "parse": "columns",
        "every_s": 30
      },
      "down": {
        "brick": "command",
        "run": [
          "gcloud",
          "compute",
          "instances",
          "list",
          "--project",
          "{{project}}"
        ],
        "parse": "columns",
        "every_s": 30,
        "where": {
          "STATUS": {
            "ne": "RUNNING"
          }
        }
      }
    },
    "views": [
      {
        "id": "vm-n",
        "brick": "stat",
        "source": "vms",
        "title": "VM"
      },
      {
        "id": "down-n",
        "brick": "stat",
        "source": "down",
        "title": "Çalışmıyor",
        "ok": 0,
        "warn_above": 0,
        "error_above": 3
      },
      {
        "id": "zones",
        "brick": "bars",
        "source": "vms",
        "title": "Zone",
        "label": "ZONE",
        "limit": 6
      },
      {
        "id": "vms",
        "brick": "table",
        "source": "vms",
        "title": "VM'ler",
        "key": "NAME",
        "columns": [
          "NAME",
          "ZONE",
          "MACHINE_TYPE",
          "INTERNAL_IP",
          "EXTERNAL_IP",
          "STATUS"
        ],
        "row_actions": [
          {
            "label": "Neden?",
            "ask": "{NAME} VM'i neden {STATUS}? describe ve seri port çıktısına bak."
          }
        ]
      }
    ]
  },
