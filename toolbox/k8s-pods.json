{
  "author": "taksim",
  "version": 1,
  "origin": "builtin",
  "createdAt": 1790848800000,
  "uses": 0,
  "learned": [],
  "id": "k8s-pods",
  "name": "Kubernetes pod'ları",
  "summary": "Bir namespace'teki pod'lar, hazır olmayanlar ve canlı olay akışı; CrashLoop ve yeniden başlamalar öne çıkar.",
  "when": [
    "kubernetes'e bak",
    "pod'lar neden restart oluyor",
    "cluster'daki pod'ları izle",
    "k8s namespace durumunu göster",
    "CrashLoopBackOff olan pod var mı",
    "watch the pods in prod",
    "kubectl get pods takip et",
    "deployment ayağa kalktı mı",
    "kubernetes olaylarını izle",
    "which pods are failing"
  ],
  "keywords": [
    "kubernetes",
    "k8s",
    "kubectl",
    "pod",
    "namespace",
    "deployment",
    "cluster",
    "crashloopbackoff",
    "events",
    "restart",
    "crash"
  ],
  "requires": {
    "bin": [
      "kubectl"
    ]
  },
  "params": {
    "context": {
      "desc": "kubeconfig context (kubectl config get-contexts)",
      "default": null
    },
    "namespace": {
      "desc": "namespace",
      "default": "default"
    }
  },
  "instructions": "Panel shows pods every 5s, the ones not Running, and the namespace's events as they happen. For a failing pod read `kubectl describe pod` (Events, Last State, exit code, OOMKilled) and `kubectl logs --previous` before explaining. Always pass the same --context and -n as the panel. Don't change the cluster unless the user asks.",
  "spec": {
    "title": "k8s · {{namespace}}",
    "sources": {
      "pods": {
        "brick": "command",
        "run": [
          "kubectl",
          "get",
          "pods",
          "--context",
          "{{context}}",
          "-n",
          "{{namespace}}",
          "-o",
          "wide"
        ],
        "parse": "columns",
        "every_s": 5
      },
      "notready": {
        "brick": "command",
        "run": [
          "kubectl",
          "get",
          "pods",
          "--context",
          "{{context}}",
          "-n",
          "{{namespace}}"
        ],
        "parse": "columns",
        "every_s": 5,
        "where": {
          "STATUS": {
            "ne": "Running"
          }
        }
      },
      "events": {
        "brick": "command",
        "run": [
          "kubectl",
          "get",
          "events",
          "--context",
          "{{context}}",
          "-n",
          "{{namespace}}",
          "--watch-only"
        ],
        "parse": "lines",
        "stream": true
      }
    },
    "views": [
      {
        "id": "pods-n",
        "brick": "stat",
        "source": "pods",
        "title": "Pod"
      },
      {
        "id": "bad-n",
        "brick": "stat",
        "source": "notready",
        "title": "Sorunlu",
        "ok": 0,
        "warn_above": 0,
        "error_above": 2
      },
      {
        "id": "pods",
        "brick": "table",
        "source": "pods",
        "title": "Pod'lar",
        "columns": [
          "NAME",
          "READY",
          "STATUS",
          "RESTARTS",
          "AGE",
          "NODE"
        ],
        "row_actions": [
          {
            "label": "Neden?",
            "ask": "{NAME} pod'u neden {STATUS}? describe ve önceki loglara bak."
          }
        ]
      },
      {
        "id": "events",
        "brick": "log",
        "source": "events",
        "title": "Olaylar"
      }
    ]
  },
  "preview": {
