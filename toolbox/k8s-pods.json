  "reference": {
    "product": "k9s",
    "url": "https://k9scli.io",
    "borrowed": [
      "pod tablosu: READY, STATUS, RESTARTS, NODE",
      "sorunlu pod sayısı",
      "namespace olay akışı",
      "context/namespace sabit"
    ]
  }
}
