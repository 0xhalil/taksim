{
  "author": "taksim",
  "version": 1,
  "origin": "builtin",
  "createdAt": 1791372600000,
  "uses": 0,
  "learned": [],
  "id": "ci-runs",
  "name": "CI koşuları",
  "summary": "GitHub Actions koşuları zaman çizelgesinde iş akışına göre: devam eden koşular canlı uzar, başarısızlar kırmızı; sürelerin grafiği.",
  "when": [
    "ci geçti mi",
    "build neden kırmızı",
    "github actions koşularına bak",
    "son pipeline'lar",
    "gh run list",
    "is CI green",
    "why did the build fail",
    "how long do our builds take",
    "ci yavaşladı mı",
    "hangi workflow kırık"
  ],
  "keywords": [
    "ci",
    "github",
    "actions",
    "gh",
    "workflow",
    "pipeline",
    "build",
    "derleme",
    "test",
    "run"
  ],
  "requires": {
    "bin": [
      "gh"
    ]
  },
  "params": {
    "limit": {
      "desc": "how many recent runs",
      "default": "30"
    }
  },
  "instructions": "Panel lists the repository's recent GitHub Actions runs every 20s (gh run list in the agent's working directory; gh's --jq adds result = conclusion or status, duration_s and day). The timeline shows each run from start to last update grouped by workflow (running and queued ones grow live), the chart shows durations. For a failed run read `gh run view <databaseId> --log-failed` and point to the failing step and the first real error, then the code. Don't re-run, cancel or merge unless the user asks (`gh run rerun` needs approval).",
  "spec": {
    "title": "CI",
    "sources": {
      "runs": {
        "brick": "command",
        "run": [
          "gh",
          "run",
          "list",
          "--limit",
          "{{limit}}",
          "--json",
          "databaseId,displayTitle,workflowName,headBranch,event,status,conclusion,createdAt,updatedAt,url",
          "--jq",
          ".[] | . + {result: (if .conclusion == \"\" or .conclusion == null then .status else .conclusion end), duration_s: ((.updatedAt | fromdate) - (.createdAt | fromdate)), day: .createdAt[0:10]}"
        ],
        "parse": "jsonl",
        "every_s": 20
      },
      "failed": {
        "brick": "command",
        "run": [
          "gh",
          "run",
          "list",
          "--limit",
          "{{limit}}",
          "--json",
          "databaseId,displayTitle,workflowName,headBranch,event,status,conclusion,createdAt,updatedAt,url",
          "--jq",
          ".[] | . + {result: (if .conclusion == \"\" or .conclusion == null then .status else .conclusion end), duration_s: ((.updatedAt | fromdate) - (.createdAt | fromdate)), day: .createdAt[0:10]}"
        ],
        "parse": "jsonl",
        "every_s": 20,
        "where": {
          "conclusion": {
            "in": [
              "failure",
              "timed_out",
              "startup_failure"
            ]
          }
        }
      }
    },
    "views": [
      {
        "id": "failed-n",
        "brick": "stat",
        "source": "failed",
        "title": "Kırık",
        "ok": 0,
        "warn_above": 0,
        "error_above": 2
      },
      {
        "id": "durations",
        "brick": "chart",
        "source": "runs",
        "title": "Süre",
        "x": "createdAt",
        "y": "duration_s",
        "scale": 0.016666666666666666,
        "unit": "dk",
        "kind": "bar",
        "span": 3
      },
      {
        "id": "timeline",
        "brick": "timeline",
        "source": "runs",
        "title": "Koşular",
        "start": "createdAt",
        "end": "updatedAt",
        "label": "displayTitle",
        "group": "workflowName",
        "status": [
          "conclusion",
          "status"
        ]
      },
      {
        "id": "runs",
        "brick": "table",
        "source": "runs",
        "title": "Son koşular",
        "key": "databaseId",
        "columns": [
          {
            "field": "workflowName",
            "label": "WORKFLOW"
          },
          {
            "field": "displayTitle",
            "label": "TITLE"
          },
          {
            "field": "headBranch",
            "label": "BRANCH"
          },
          {
            "field": "result",
            "label": "RESULT"
          },
          {
            "field": "duration_s",
            "label": "SÜRE (sn)"
          }
        ],
        "bar": "duration_s",
        "row_actions": [
          {
            "label": "Neden?",
            "ask": "{workflowName} koşusu ({databaseId}, {headBranch}) neden {result}? gh run view {databaseId} --log-failed ile bak."
          }
        ]
      }
    ]
  },
