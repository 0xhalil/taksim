{
  "author": "taksim",
  "version": 1,
  "origin": "builtin",
  "createdAt": 1791372600000,
  "uses": 0,
  "learned": [],
  "id": "team-activity",
  "name": "Ekip aktivitesi",
  "summary": "Bir dönemde kim kaç commit attı canlı sıralamada; günlük commit ritmi çubuk grafikte.",
  "when": [
    "ekip bu ay ne yaptı",
    "kim kaç commit attı",
    "son iki haftanın aktivitesi",
    "repo'da kim çalışıyor",
    "git shortlog",
    "team activity this sprint",
    "commits per author",
    "commits per day",
    "takımın ritmi nasıl",
    "who worked on this repo lately"
  ],
  "keywords": [
    "git",
    "commit",
    "author",
    "team",
    "ekip",
    "activity",
    "aktivite",
    "shortlog",
    "sprint",
    "velocity",
    "manager"
  ],
  "requires": {
    "bin": [
      "git"
    ]
  },
  "params": {
    "since": {
      "desc": "period for git log --since, e.g. 14.days, 1.month, 2026-09-01",
      "default": "14.days"
    }
  },
  "instructions": "Panel reads `git log --since --no-merges` in the agent's working directory every 5 minutes (author and day per commit), ranks authors by commits and charts commits per day. Commit counts are a rhythm, not a performance measure: when asked about the team, describe the trend (busy days, quiet stretches, who carried which area by looking at the files they touched with `git log --author <name> --stat`), and don't rank people as better or worse.",
  "spec": {
    "title": "ekip · {{since}}",
    "sources": {
      "commits": {
        "brick": "command",
        "run": [
          "git",
          "log",
          "--since={{since}}",
          "--no-merges",
          "--date=short",
          "--format=%an%x09%ad"
        ],
        "parse": {
          "regex": "^(?<author>[^\\t]+)\\t(?<day>\\S+)$"
        },
        "every_s": 300
      }
    },
    "views": [
      {
        "id": "total",
        "brick": "stat",
        "source": "commits",
        "title": "Commit"
      },
      {
        "id": "per-day",
        "brick": "chart",
        "source": "commits",
        "title": "Günlük",
        "x": "day",
        "kind": "bar",
        "span": 3
      },
      {
        "id": "by-author",
        "brick": "bars",
        "source": "commits",
        "title": "Kişi",
        "label": "author",
        "limit": 10,
        "span": 4
      }
    ]
  },
