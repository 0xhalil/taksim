{
  "author": "taksim",
  "version": 1,
  "origin": "builtin",
  "createdAt": 1791372600000,
  "uses": 0,
  "learned": [],
  "id": "deploy-history",
  "name": "Deploy geçmişi",
  "summary": "Bir deploy iş akışının koşuları zaman çizelgesinde: ne zaman, ne kadar sürdü, başarılı mı; günlük deploy sayısı ve son sonuç.",
  "when": [
    "en son ne zaman deploy ettik",
    "deploy geçmişini göster",
    "dün kaç deploy yaptık",
    "son deploy başarılı mı",
    "deploy sıklığı",
    "show the deploy history",
    "when did we last ship",
    "how often do we deploy",
    "hangi deploy patladı",
    "release takvimi"
  ],
  "keywords": [
    "deploy",
    "release",
    "dağıtım",
    "history",
    "geçmiş",
    "github",
    "actions",
    "gh",
    "dora",
    "frequency",
    "manager"
  ],
  "requires": {
    "bin": [
      "gh"
    ]
  },
  "params": {
    "workflow": {
      "desc": "the deploy workflow file or name (gh workflow list)",
      "default": "deploy.yml"
    },
    "limit": {
      "desc": "how many recent deploys",
      "default": "40"
    }
  },
  "instructions": "Panel lists the runs of the deploy workflow every 30s (gh run list --workflow in the agent's working directory; gh's --jq adds result, duration_s and day). The timeline shows each deploy with its outcome (a running one grows live), the chart counts deploys per day (deploy frequency) and the big number is the latest result. For a failed deploy read `gh run view <databaseId> --log-failed`; to say what a deploy shipped compare its commit with the previous successful one (`git log <prev>..<this> --oneline`). For Kubernetes-only teams `kubectl rollout history deployment/<name>` is the other source. Don't re-run or roll back unless the user asks.",
  "spec": {
    "title": "deploy · {{workflow}}",
    "sources": {
      "deploys": {
        "brick": "command",
        "run": [
          "gh",
          "run",
          "list",
          "--workflow",
          "{{workflow}}",
          "--limit",
          "{{limit}}",
          "--json",
          "databaseId,displayTitle,workflowName,headBranch,event,status,conclusion,createdAt,updatedAt,url",
          "--jq",
          ".[] | . + {result: (if .conclusion == \"\" or .conclusion == null then .status else .conclusion end), duration_s: ((.updatedAt | fromdate) - (.createdAt | fromdate)), day: .createdAt[0:10]}"
        ],
        "parse": "jsonl",
        "every_s": 30
      }
    },
    "views": [
      {
        "id": "last",
        "brick": "stat",
        "source": "deploys",
        "title": "Son deploy",
        "value": "result",
        "ok": "success"
      },
      {
        "id": "per-day",
        "brick": "chart",
        "source": "deploys",
        "title": "Günlük deploy",
        "x": "day",
        "kind": "bar",
        "span": 3
      },
      {
        "id": "timeline",
        "brick": "timeline",
        "source": "deploys",
        "title": "Deploy'lar",
        "start": "createdAt",
        "end": "updatedAt",
        "label": "displayTitle",
        "status": "result"
      },
      {
        "id": "deploys",
        "brick": "table",
        "source": "deploys",
        "title": "Geçmiş",
        "key": "databaseId",
        "columns": [
          {
            "field": "displayTitle",
            "label": "DEPLOY"
          },
          {
            "field": "result",
            "label": "RESULT"
          },
          {
            "field": "createdAt",
            "label": "STARTED"
          },
          {
            "field": "duration_s",
            "label": "SÜRE (sn)"
          }
        ],
        "row_actions": [
          {
            "label": "Ne çıktı?",
            "ask": "{displayTitle} ({databaseId}) deploy'u neyi canlıya çıkardı? Önceki başarılı deploy ile farkı ne?"
          }
        ]
      }
    ]
  },
