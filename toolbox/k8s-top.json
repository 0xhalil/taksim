{
  "author": "taksim",
  "version": 1,
  "origin": "builtin",
  "createdAt": 1791372600000,
  "uses": 0,
  "learned": [],
  "id": "k8s-top",
  "name": "Kubernetes kaynak kullanımı",
  "summary": "kubectl top ile pod'ların CPU ve bellek sıralaması canlı yarışta; namespace'in toplam CPU ve belleği zaman içinde.",
  "when": [
    "hangi pod çok CPU yiyor",
    "pod'ların bellek kullanımı",
    "namespace'in kaynak tüketimi",
    "kubectl top pods izle",
    "memory leak var mı bak",
    "which pod uses the most memory",
    "cpu usage per pod",
    "cluster neden yavaş",
    "node'lar dolu mu",
    "kaynak limitine yaklaşan pod"
  ],
  "keywords": [
    "kubernetes",
    "k8s",
    "kubectl",
    "top",
    "cpu",
    "memory",
    "bellek",
    "kaynak",
    "metrics",
    "node",
    "pod"
  ],
  "requires": {
    "bin": [
      "kubectl"
    ]
  },
  "params": {
    "context": {
      "desc": "kubeconfig context (kubectl config get-contexts)",
      "default": null
    },
    "namespace": {
      "desc": "namespace",
      "default": "default"
    }
  },
  "instructions": "Panel ranks pods by CPU and memory from `kubectl top pods` every 5s, charts the namespace's total CPU (cores) and memory (MiB), and lists nodes with their CPU%/MEMORY%. Needs metrics-server; if top fails say so. Compare a hungry pod with its requests/limits (`kubectl get pod -o jsonpath='{.spec.containers[*].resources}'`) before calling it a problem; a steadily rising memory line suggests a leak, a CPU pinned at its limit suggests throttling. Pass the same --context and -n as the panel.",
  "spec": {
    "title": "top · {{namespace}}",
    "sources": {
      "top": {
        "brick": "command",
        "run": [
          "kubectl",
          "top",
          "pods",
          "--context",
          "{{context}}",
          "-n",
          "{{namespace}}"
        ],
        "parse": "columns",
        "every_s": 5
      },
      "nodes": {
        "brick": "command",
        "run": [
          "kubectl",
          "top",
          "nodes",
          "--context",
          "{{context}}"
        ],
        "parse": "columns",
        "every_s": 10
      }
    },
    "views": [
      {
        "id": "cpu-total",
        "brick": "chart",
        "source": "top",
        "title": "Toplam CPU",
        "y": "CPU(cores)",
        "agg": "sum",
        "unit": "core",
        "kind": "area"
      },
      {
        "id": "mem-total",
        "brick": "chart",
        "source": "top",
        "title": "Toplam bellek",
        "y": "MEMORY(bytes)",
        "agg": "sum",
        "scale": 9.5367431640625e-7,
        "unit": "Mi",
        "kind": "line"
      },
      {
        "id": "cpu",
        "brick": "bars",
        "source": "top",
        "title": "CPU",
        "label": "NAME",
        "value": "CPU(cores)",
        "limit": 8
      },
      {
        "id": "mem",
        "brick": "bars",
        "source": "top",
        "title": "Bellek",
        "label": "NAME",
        "value": "MEMORY(bytes)",
        "limit": 8
      },
      {
        "id": "nodes",
        "brick": "table",
        "source": "nodes",
        "title": "Node'lar",
        "bar": "CPU%",
        "columns": [
          "NAME",
          "CPU(cores)",
          "CPU%",
          "MEMORY(bytes)",
          "MEMORY%"
        ]
      }
    ]
  },
