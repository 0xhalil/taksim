{
  "author": "taksim",
  "version": 1,
  "origin": "builtin",
  "createdAt": 1791372600000,
  "uses": 0,
  "learned": [],
  "id": "gcp-logs",
  "name": "Google Cloud logları",
  "summary": "Cloud Logging'den son kayıtlar seviyesine göre renkli; hata sayısının çizgisi ve en çok log üreten servisler.",
  "when": [
    "gcp loglarına bak",
    "cloud run hata logları",
    "son 10 dakikadaki hatalar",
    "gcloud logging read",
    "prod'da error var mı",
    "show me the errors in cloud logging",
    "stackdriver loglarını izle",
    "hangi servis hata veriyor",
    "tail gcp logs",
    "log explorer'daki hatalar"
  ],
  "keywords": [
    "gcp",
    "gcloud",
    "logging",
    "logs",
    "log",
    "stackdriver",
    "error",
    "hata",
    "severity",
    "cloud run",
    "google cloud"
  ],
  "requires": {
    "bin": [
      "gcloud"
    ]
  },
  "params": {
    "project": {
      "desc": "Google Cloud project id (gcloud projects list)",
      "default": null
    },
    "filter": {
      "desc": "Cloud Logging filter, e.g. resource.type=cloud_run_revision",
      "default": "severity>=DEFAULT"
    },
    "freshness": {
      "desc": "how far back to read (gcloud --freshness), e.g. 10m, 1h",
      "default": "10m"
    }
  },
  "instructions": "Panel reads the newest 200 log entries matching the filter every 15s (gcloud logging read, --freshness window), shows them colored by severity, counts errors over time and ranks services by how much they log. To explain an error, read more context around its timestamp (`gcloud logging read '<filter> AND timestamp>=\"<t-1m>\" AND timestamp<=\"<t+1m>\"' --project <project>`) and find the code that logs it. Keep the same --project; narrow the filter with the user rather than reading everything.",
  "spec": {
    "title": "loglar · {{project}}",
    "sources": {
      "logs": {
        "brick": "command",
        "run": [
          "gcloud",
          "logging",
          "read",
          "{{filter}}",
          "--project",
          "{{project}}",
          "--freshness={{freshness}}",
          "--limit=200",
          "--format=json"
        ],
        "parse": "json",
        "sort": "timestamp",
        "every_s": 15
      },
      "errors": {
        "brick": "command",
        "run": [
          "gcloud",
          "logging",
          "read",
          "{{filter}}",
          "--project",
          "{{project}}",
          "--freshness={{freshness}}",
          "--limit=200",
          "--format=json"
        ],
        "parse": "json",
        "every_s": 15,
        "where": {
          "severity": {
            "in": [
              "ERROR",
              "CRITICAL",
              "ALERT",
              "EMERGENCY"
            ]
          }
        }
      }
    },
    "views": [
      {
        "id": "err-n",
        "brick": "stat",
        "source": "errors",
        "title": "Hata",
        "ok": 0,
        "warn_above": 0,
        "error_above": 5
      },
      {
        "id": "err-trend",
        "brick": "chart",
        "source": "errors",
        "title": "Hatalar",
        "kind": "bar",
        "warn_above": 3,
        "error_above": 8,
        "span": 3
      },
      {
        "id": "log",
        "brick": "log",
        "source": "logs",
        "title": "Kayıtlar",
        "text": [
          "textPayload",
          "jsonPayload.message",
          "protoPayload.status.message"
        ],
        "level": "severity",
        "row_actions": [
          {
            "label": "Açıkla",
            "ask": "Bu {severity} log kaydını açıkla ve kaynağını bul."
          }
        ]
      },
      {
        "id": "by-svc",
        "brick": "bars",
        "source": "logs",
        "title": "Servis",
        "label": "resource.labels.service_name",
        "limit": 6
      },
      {
        "id": "by-sev",
        "brick": "bars",
        "source": "logs",
        "title": "Seviye",
        "label": "severity",
        "limit": 6
      }
    ]
  },
