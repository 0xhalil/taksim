{
  "author": "taksim",
  "version": 1,
  "origin": "builtin",
  "createdAt": 1790848800000,
  "uses": 0,
  "learned": [],
  "id": "docker-containers",
  "name": "Docker container'ları",
  "summary": "Bu makinedeki container'lar, durumları ve kaynak kullanımları; çöken ya da yeniden başlayanlar öne çıkar.",
  "when": [
    "docker container'larını izle",
    "hangi container'lar çalışıyor",
    "container neden sürekli restart oluyor",
    "docker ps'i takip et",
    "compose servisleri ayakta mı",
    "watch my docker containers",
    "which containers are down",
    "container cpu ve bellek kullanımı",
    "exited container'ları göster",
    "docker stats"
  ],
  "keywords": [
    "docker",
    "container",
    "konteyner",
    "compose",
    "image",
    "restart",
    "exited",
    "stats",
    "cpu",
    "memory"
  ],
  "requires": {
    "bin": [
      "docker"
    ]
  },
  "params": {},
  "instructions": "Panel shows `docker ps -a` every 5s and `docker stats` every 10s. Look at State/Status first: Exited (non-zero), Restarting or unhealthy containers are the problems. For one of them, read `docker logs --tail 100 <name>` and `docker inspect <name>` (State, RestartCount, OOMKilled) before explaining. Row action 'Neden?' sends you the row.",
  "spec": {
    "title": "Docker",
    "sources": {
      "ps": {
        "brick": "command",
        "run": [
          "docker",
          "ps",
          "-a",
          "--format",
          "{{json .}}"
        ],
        "parse": "jsonl",
        "every_s": 5
      },
      "running": {
        "brick": "command",
        "run": [
          "docker",
          "ps",
          "--format",
          "{{json .}}"
        ],
        "parse": "jsonl",
        "every_s": 5
      },
      "stats": {
        "brick": "command",
        "run": [
          "docker",
          "stats",
          "--no-stream",
          "--format",
          "{{json .}}"
        ],
        "parse": "jsonl",
        "every_s": 10
      }
    },
    "views": [
      {
        "id": "running",
        "brick": "stat",
        "source": "running",
        "title": "Çalışan"
      },
      {
        "id": "all",
        "brick": "stat",
        "source": "ps",
        "title": "Toplam"
      },
      {
        "id": "ps",
        "brick": "table",
        "source": "ps",
        "title": "Container'lar",
        "columns": [
          "Names",
          "State",
          "Status",
          "Image",
          "Ports"
        ],
        "row_actions": [
          {
            "label": "Neden?",
            "ask": "{Names} neden {Status} durumunda? Loglarına ve inspect çıktısına bak."
          }
        ]
      },
      {
        "id": "stats",
        "brick": "table",
        "source": "stats",
        "title": "Kaynak",
        "columns": [
          "Name",
          "CPUPerc",
          "MemUsage",
          "NetIO"
        ]
      }
    ]
  },
