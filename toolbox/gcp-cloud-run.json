{
  "author": "taksim",
  "version": 1,
  "origin": "builtin",
  "createdAt": 1791372600000,
  "uses": 0,
  "learned": [],
  "id": "gcp-cloud-run",
  "name": "Cloud Run servisleri",
  "summary": "Bir projedeki Cloud Run servisleri: bölge, URL, son hazır revizyon ve hazır olmayanlar; en yeni revizyonlar altta.",
  "when": [
    "cloud run servislerine bak",
    "cloud run deploy oldu mu",
    "hangi servis hazır değil",
    "son revizyonlar neler",
    "gcloud run services list",
    "show my cloud run services",
    "is the new revision serving",
    "cloud run'da ne çalışıyor",
    "servisin URL'si ne",
    "check cloud run in prod"
  ],
  "keywords": [
    "gcp",
    "gcloud",
    "google cloud",
    "cloud run",
    "run",
    "serverless",
    "revision",
    "service",
    "servis",
    "deploy"
  ],
  "requires": {
    "bin": [
      "gcloud"
    ]
  },
  "params": {
    "project": {
      "desc": "Google Cloud project id (gcloud projects list)",
      "default": null
    }
  },
  "instructions": "Panel lists the project's Cloud Run services every 30s (region, ready, latest ready revision, URL, who deployed) and the newest revisions. For a service that isn't ready, read `gcloud run services describe <name> --region <region> --project <project>` (status.conditions messages) and its logs (`gcloud logging read 'resource.type=cloud_run_revision AND resource.labels.service_name=<name>' --freshness=30m --project <project>`) before explaining. Always pass the same --project. Don't deploy, update traffic or delete unless the user asks.",
  "spec": {
    "title": "Cloud Run · {{project}}",
    "sources": {
      "services": {
        "brick": "command",
        "run": [
          "gcloud",
          "run",
          "services",
          "list",
          "--project",
          "{{project}}",
          "--format=json"
        ],
        "parse": "json",
        "every_s": 30
      },
      "notready": {
        "brick": "command",
        "run": [
          "gcloud",
          "run",
          "services",
          "list",
          "--project",
          "{{project}}",
          "--format=json"
        ],
        "parse": "json",
        "every_s": 30,
        "where": {
          "status.conditions.0.status": {
            "ne": "True"
          }
        }
      },
      "revisions": {
        "brick": "command",
        "run": [
          "gcloud",
          "run",
          "revisions",
          "list",
          "--project",
          "{{project}}",
          "--format=json",
          "--sort-by=~metadata.creationTimestamp",
          "--limit=20"
        ],
        "parse": "json",
        "every_s": 60
      }
    },
    "views": [
      {
        "id": "svc-n",
        "brick": "stat",
        "source": "services",
        "title": "Servis"
      },
      {
        "id": "bad-n",
        "brick": "stat",
        "source": "notready",
        "title": "Hazır değil",
        "ok": 0,
        "warn_above": 0,
        "error_above": 1
      },
      {
        "id": "services",
        "brick": "table",
        "source": "services",
        "title": "Servisler",
        "key": "metadata.name",
        "columns": [
          {
            "field": "metadata.name",
            "label": "SERVICE"
          },
          {
            "field": "metadata.labels[cloud.googleapis.com/location]",
            "label": "REGION"
          },
          {
            "field": "status.conditions.0.status",
            "label": "READY"
          },
          {
            "field": "status.latestReadyRevisionName",
            "label": "REVISION"
          },
          {
            "field": "status.url",
            "label": "URL"
          },
          {
            "field": "metadata.annotations[serving.knative.dev/lastModifier]",
            "label": "BY"
          }
        ],
        "row_actions": [
          {
            "label": "Neden?",
            "ask": "{metadata.name} Cloud Run servisi neden hazır değil? describe ve son loglarına bak."
          }
        ]
      },
      {
        "id": "revisions",
        "brick": "table",
        "source": "revisions",
        "title": "Revizyonlar",
        "key": "metadata.name",
        "columns": [
          {
            "field": "metadata.name",
            "label": "REVISION"
          },
          {
            "field": "metadata.labels[serving.knative.dev/service]",
            "label": "SERVICE"
          },
          {
            "field": "status.conditions.0.status",
            "label": "READY"
          },
          {
            "field": "metadata.creationTimestamp",
            "label": "CREATED"
          },
          {
            "field": "spec.containers.0.image",
            "label": "IMAGE"
          }
        ]
      }
    ]
  },
